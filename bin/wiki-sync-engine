#!/usr/bin/env python3
"""
wiki-sync-engine: Push engine/CLI improvements from KOS -> Brian (open source).

One-way data flow (enforced)
----------------------------
* Engine functionality may flow **KOS → Brian only**. There is **no pull**.
* Company knowledge never syncs: ``wiki/``, ``raw/``, ``internal/registry.md``,
  ``internal/skills/``, ``benchmarks/``, and other knowledge trees are excluded.
* Reverse direction (Brian → KOS) is refused via repo-role classification.
* Brian-specific assets are never clobbered (README, resources, wiki, raw,
  AGENTS.md, wiki.toml, init personalization, etc.).
* Brand sanitization + ``wiki-leak-check`` run on every apply (fail closed).

Usage
-----
  bin/wiki-sync-engine push                  # -> ../brian
  bin/wiki-sync-engine push /path/to/brian
  bin/wiki-sync-engine push --dry-run
  bin/wiki-sync-engine status                # show what would change
"""

from __future__ import annotations

import argparse
import filecmp
import os
import re
import subprocess
import sys
from pathlib import Path

# Engine paths owned by KOS. Copied as an overlay (update/add), never wholesale
# directory replace, so Brian-only files under these trees survive.
ENGINE_PATHS = [
    "wikicli",
    "bin",
    "commands",
    "_templates",
    "internal/mcp_server_wiki.py",
    "internal/prompts",
    "tests",
]

# Top-level / path prefixes that must never be written by sync (Brian-owned).
BRIAN_OWNED_PATHS = frozenset(
    {
        "README.md",
        "AGENTS.md",
        "wiki.toml",
        "uv.lock",
        ".gitignore",
        ".github",
        "resources",
        "wiki",
        "raw",
        "benchmarks",
        "internal/registry.md",
        "internal/skills",
        "LICENSE",
        "LICENSE.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
    }
)

# Defense-in-depth: never treat knowledge / OSS-identity trees as engine payload.
NEVER_SYNC_PREFIXES = (
    "wiki/",
    "raw/",
    "resources/",
    "benchmarks/",
    "internal/skills/",
    ".git/",
    ".github/",
)

NEVER_SYNC_EXACT = frozenset(
    {
        "wiki",
        "raw",
        "resources",
        "benchmarks",
        "README.md",
        "AGENTS.md",
        "wiki.toml",
        "uv.lock",
        ".gitignore",
        "LICENSE",
        "LICENSE.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "internal/registry.md",
        "internal/skills",
    }
)

# Files under ENGINE_PATHS that are Brian-local and must not be overwritten
# even if a same-named file appears in KOS later. Overlay never deletes
# Brian-only files missing from KOS; this set also blocks overwrite if KOS
# ever gains a same-named path.
BRIAN_OWNED_ENGINE_FILES = frozenset(
    {
        "wikicli/lifecycle/init.py",
        "tests/lifecycle/test_init.py",
        # OSS agent pointer branding / init-managed markers (not private company copy).
        "_templates/agent-pointer.md",
    }
)

ENGINE_COPY_DENY_SUFFIXES = {".pyc", ".pyo", ".lock"}
ENGINE_COPY_DENY_DIR_NAMES = {
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".DS_Store",
    ".venv",
    "venv",
    "node_modules",
}

BINARY_SUFFIXES = {
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".pdf",
    ".zip",
    ".gz",
    ".pyc",
    ".pyo",
    ".so",
    ".dylib",
    ".woff",
    ".woff2",
    ".ttf",
}

# pyproject identity keys preserved from Brian on merge.
PYPROJECT_PRESERVE_PROJECT_KEYS = (
    "name",
    "description",
    "readme",
    "authors",
    "maintainers",
    "license",
    "urls",
    "keywords",
    "classifiers",
)

# Markers used only for direction safety (not copied as content).
_PRIVATE = "k" + "rv"  # company slug fragment
_PRIVATE_ORG = "K" + "rv" + "-Labs"


def _brand_replacements() -> list[tuple[str, str]]:
    c = "k" + "rv"
    C = "K" + "rv"
    return [
        (f"{c}-labs.md", "brian-overview.md"),
        (f"{C} Labs", "My Org"),
        (f"{C}-Labs", "Brian-Org"),
        (f"{c}-labs", "brian-org"),
        (f"{C} Wiki", "Brian Wiki"),
        (f"{c}-wiki", "brian-wiki"),
        (f"{c}_wiki", "brian_wiki"),
        (f"team@{c}.ai", "team@example.com"),
        (f"engineering@{c}.ai", "team@example.com"),
        (f"engineering@{c}labs.com", "team@example.com"),
        (f"@{c}.ai", "@example.com"),
        (f"@{c}labs.com", "@example.com"),
        (f"{c}.ai", "example.com"),
        (f"{c}labs.com", "example.com"),
        (C, "Brian"),
        (c, "brian"),
    ]


def sanitize_text(content: str) -> str:
    for old, new in _brand_replacements():
        content = content.replace(old, new)
        content = content.replace(old.lower(), new.lower())
        content = content.replace(old.upper(), new.upper())
    return content


def should_skip_source_file(path: Path) -> bool:
    if path.name in ENGINE_COPY_DENY_DIR_NAMES or path.name == ".DS_Store":
        return True
    if path.suffix.lower() in ENGINE_COPY_DENY_SUFFIXES:
        return True
    if any(part in ENGINE_COPY_DENY_DIR_NAMES for part in path.parts):
        return True
    return False


def is_never_sync_path(rel_posix: str) -> bool:
    rel = rel_posix.replace("\\", "/")
    if rel in NEVER_SYNC_EXACT or rel in BRIAN_OWNED_PATHS or rel in BRIAN_OWNED_ENGINE_FILES:
        return True
    for prefix in NEVER_SYNC_PREFIXES:
        if rel == prefix.rstrip("/") or rel.startswith(prefix):
            return True
    for owned in BRIAN_OWNED_PATHS:
        if rel == owned or rel.startswith(owned.rstrip("/") + "/"):
            return True
    return False


def is_brian_owned(rel_posix: str) -> bool:
    rel = rel_posix.replace("\\", "/")
    if rel in BRIAN_OWNED_PATHS or rel in BRIAN_OWNED_ENGINE_FILES:
        return True
    for owned in BRIAN_OWNED_PATHS:
        if rel == owned or rel.startswith(owned.rstrip("/") + "/"):
            return True
    return False


def looks_like_engine_repo(path: Path) -> bool:
    return path.is_dir() and (path / "pyproject.toml").is_file()


def _read_text_if_exists(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def _git_origin(repo: Path) -> str:
    try:
        res = subprocess.run(
            ["git", "-C", str(repo), "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return ""
    if res.returncode != 0:
        return ""
    return (res.stdout or "").strip()


def classify_repo_role(repo: Path) -> str:
    """
    Return one of: private_kos | oss_brian | unknown

    Used only to enforce one-way engine flow. Knowledge paths are never synced
    regardless of classification.
    """
    py = _read_text_if_exists(repo / "pyproject.toml")
    wiki_toml = _read_text_if_exists(repo / "wiki.toml")
    origin = _git_origin(repo)
    score_private = 0
    score_brian = 0

    if f'name = "{_PRIVATE}-wiki"' in py or f"name = '{_PRIVATE}-wiki'" in py:
        score_private += 3
    if 'name = "brian-wiki"' in py or "name = 'brian-wiki'" in py:
        score_brian += 3

    if f"{_PRIVATE}-labs.md" in wiki_toml or f"entities/{_PRIVATE}-labs" in wiki_toml:
        score_private += 3
    if "brian-overview.md" in wiki_toml:
        score_brian += 2

    if (repo / "wiki" / "entities" / f"{_PRIVATE}-labs.md").is_file():
        score_private += 4
    if (repo / "wiki" / "entities" / "brian-overview.md").is_file():
        score_brian += 2

    projects = repo / "wiki" / "projects"
    if projects.is_dir() and any(projects.glob("*.md")):
        score_private += 4
    raw_dir = repo / "raw"
    if raw_dir.is_dir():
        for p in raw_dir.rglob("*"):
            if p.is_file() and p.name != ".gitkeep":
                score_private += 3
                break

    if (repo / "resources" / "brian.svg").is_file():
        score_brian += 2

    if _PRIVATE_ORG in origin or f"{_PRIVATE}-Labs/kos" in origin or origin.rstrip("/").endswith("/kos.git"):
        score_private += 2
    if re.search(r"/brian(?:\.git)?$", origin) or "brian-wiki" in origin:
        score_brian += 2

    if score_private >= 3 and score_private > score_brian:
        return "private_kos"
    if score_brian >= 3 and score_brian > score_private:
        return "oss_brian"
    return "unknown"


def assert_safe_direction(src_repo: Path, dst_repo: Path) -> str | None:
    """Return an error message if this sync would violate one-way KOS→Brian flow."""
    if src_repo.resolve() == dst_repo.resolve():
        return "Refusing to sync a repo onto itself."

    src_role = classify_repo_role(src_repo)
    dst_role = classify_repo_role(dst_repo)

    if dst_role == "private_kos":
        return (
            "Refusing sync into a private company knowledge base (KOS). "
            "Engine flow is KOS → Brian only; there is no pull/reverse path."
        )

    if src_role == "oss_brian":
        return (
            "Refusing reverse engine sync (Brian as source). "
            "Run this command from KOS and push toward Brian only."
        )

    if src_role == "unknown" and dst_role == "oss_brian":
        if not any((src_repo / rel).exists() for rel in ENGINE_PATHS):
            return "Source does not contain engine paths to push."

    return None


def default_brian_path(kos_root: Path) -> Path | None:
    """Prefer ../brian, then BRIAN_REPO env, then common sibling names."""
    env = os.environ.get("BRIAN_REPO") or os.environ.get("BRIAN_PATH")
    candidates: list[Path] = []
    if env:
        candidates.append(Path(env).expanduser())
    candidates.extend(
        [
            kos_root.parent / "brian",
            kos_root.parent / "Brian",
            Path.home() / "Repos" / "brian",
        ]
    )
    for c in candidates:
        try:
            resolved = c.resolve()
        except OSError:
            continue
        if looks_like_engine_repo(resolved):
            return resolved
    return None


def iter_engine_files(src_repo: Path) -> list[tuple[str, Path]]:
    """Return (relative_posix, absolute_path) for every file under ENGINE_PATHS."""
    out: list[tuple[str, Path]] = []
    for rel in ENGINE_PATHS:
        if is_never_sync_path(rel):
            continue
        src = src_repo / rel
        if not src.exists():
            continue
        if src.is_file():
            rel_p = rel.replace("\\", "/")
            if should_skip_source_file(src) or is_never_sync_path(rel_p) or is_brian_owned(rel_p):
                continue
            out.append((rel_p, src))
            continue
        for p in src.rglob("*"):
            if not p.is_file() or should_skip_source_file(p):
                continue
            rel_p = p.relative_to(src_repo).as_posix()
            if is_never_sync_path(rel_p) or is_brian_owned(rel_p):
                continue
            out.append((rel_p, p))
    return out


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return None


def sanitize_file_bytes_or_text(src: Path, sanitize: bool) -> bytes:
    """Return content to write. Text files may be sanitized; binaries copied raw."""
    if src.suffix.lower() in BINARY_SUFFIXES or not sanitize:
        return src.read_bytes()
    text = read_text(src)
    if text is None:
        return src.read_bytes()
    return sanitize_text(text).encode("utf-8")


def files_differ(src: Path, dst: Path, sanitize: bool) -> bool:
    if not dst.exists():
        return True
    if src.suffix.lower() in BINARY_SUFFIXES or not sanitize:
        return not filecmp.cmp(src, dst, shallow=False)
    src_text = read_text(src)
    dst_text = read_text(dst)
    if src_text is None or dst_text is None:
        return not filecmp.cmp(src, dst, shallow=False)
    return sanitize_text(src_text) != dst_text


def _extract_table_body(text: str, header: str) -> str | None:
    """Return body of a TOML table including the header line, through next [table]."""
    table = header.strip("[]")
    pattern = re.compile(
        rf"(?ms)^(\[{re.escape(table)}\]\n)(.*?)(?=^\[|\Z)",
    )
    m = pattern.search(text)
    if not m:
        return None
    return m.group(1) + m.group(2)


def _replace_or_insert_project_field(project_body: str, key: str, assignment_line: str) -> str:
    """Replace key assignment inside a [project] body, or insert after header."""
    multi = re.compile(
        rf"(?ms)^({re.escape(key)}\s*=\s*)"
        r"(?:(?:\[[^\]]*?\])|(?:\{[^\}]*?\})|(?:\"\"\".*?\"\"\")|(?:'''.*?''')|(?:\"[^\"]*\")|(?:'[^']*')|(?:[^\n]+))"
        r"[^\n]*\n?"
    )
    if multi.search(project_body):
        return multi.sub(assignment_line.rstrip() + "\n", project_body, count=1)
    lines = project_body.splitlines(keepends=True)
    if not lines:
        return assignment_line.rstrip() + "\n"
    return lines[0] + assignment_line.rstrip() + "\n" + "".join(lines[1:])


def _get_project_assignment(project_body: str, key: str) -> str | None:
    multi = re.compile(
        rf"(?ms)^({re.escape(key)}\s*=\s*)"
        r"((?:\[[^\]]*?\])|(?:\{[^\}]*?\})|(?:\"\"\".*?\"\"\")|(?:'''.*?''')|(?:\"[^\"]*\")|(?:'[^']*')|(?:[^\n]+))"
        r"([^\n]*)\n?"
    )
    m = multi.search(project_body)
    if not m:
        return None
    return m.group(0)


def merge_pyproject(kos_text: str, brian_text: str) -> str:
    """
    Take engine-relevant sections from sanitized KOS pyproject, but keep Brian's
    package identity fields (name, authors, description, etc.).

    Preserved identity values are still brand-sanitized so a stale
    engineering@-legacy email cannot ship to OSS.
    """
    kos = sanitize_text(kos_text)
    result = kos

    kos_proj = _extract_table_body(kos, "project")
    brian_proj = _extract_table_body(brian_text, "project")
    if not kos_proj or not brian_proj:
        return sanitize_text(brian_text) if brian_text else kos

    merged_proj = kos_proj
    for key in PYPROJECT_PRESERVE_PROJECT_KEYS:
        brian_assign = _get_project_assignment(brian_proj, key)
        if brian_assign:
            # Keep Brian's field choice, but strip company brand/domain leftovers.
            merged_proj = _replace_or_insert_project_field(
                merged_proj, key, sanitize_text(brian_assign)
            )

    result = re.sub(
        r"(?ms)^(\[project\]\n)(.*?)(?=^\[|\Z)",
        merged_proj if merged_proj.endswith("\n") else merged_proj + "\n",
        result,
        count=1,
    )

    if 'name = "brian-wiki"' in brian_text or "name = 'brian-wiki'" in brian_text:
        result = re.sub(
            r'(?m)^(name\s*=\s*)(".*?")',
            r'\1"brian-wiki"',
            result,
            count=1,
        )

    return result


def plan_pyproject(src_repo: Path, dst_repo: Path) -> tuple[str, str, bool]:
    """Return (rel, new_text, changed)."""
    kos_p = src_repo / "pyproject.toml"
    bri_p = dst_repo / "pyproject.toml"
    kos_text = kos_p.read_text(encoding="utf-8")
    bri_text = bri_p.read_text(encoding="utf-8") if bri_p.exists() else ""
    if bri_text:
        merged = merge_pyproject(kos_text, bri_text)
    else:
        merged = sanitize_text(kos_text)
        merged = re.sub(r'(?m)^name\s*=\s*".*?"', 'name = "brian-wiki"', merged, count=1)
        merged = re.sub(
            r"(?ms)^authors\s*=\s*\[.*?\]",
            'authors = [\n    { name = "My Org", email = "team@example.com" }\n]',
            merged,
            count=1,
        )
    changed = (not bri_p.exists()) or (bri_text != merged)
    return "pyproject.toml", merged, changed


class Change:
    __slots__ = ("rel", "action", "detail")

    def __init__(self, rel: str, action: str, detail: str = ""):
        self.rel = rel
        self.action = action  # add | update | skip | merge
        self.detail = detail


def build_plan(src_repo: Path, dst_repo: Path, sanitize: bool) -> list[Change]:
    changes: list[Change] = []

    for rel, src in iter_engine_files(src_repo):
        if is_brian_owned(rel) or is_never_sync_path(rel):
            changes.append(Change(rel, "skip", "brian-owned-or-knowledge"))
            continue
        dst = dst_repo / rel
        if not dst.exists():
            changes.append(Change(rel, "add"))
        elif files_differ(src, dst, sanitize=sanitize):
            changes.append(Change(rel, "update"))
        else:
            changes.append(Change(rel, "skip", "identical"))

    rel, _merged, changed = plan_pyproject(src_repo, dst_repo)
    if changed:
        changes.append(Change(rel, "merge", "preserve Brian identity"))
    else:
        changes.append(Change(rel, "skip", "pyproject identity+engine unchanged"))

    return changes


def apply_plan(
    src_repo: Path,
    dst_repo: Path,
    changes: list[Change],
    sanitize: bool,
    dry_run: bool,
) -> int:
    applied = 0
    for ch in changes:
        if ch.action == "skip":
            continue
        # Hard refuse knowledge / Brian-owned paths even if a Change slipped in.
        if is_never_sync_path(ch.rel) or is_brian_owned(ch.rel):
            print(f"  ! refuse {ch.rel} (owned/knowledge path)")
            continue
        dst = dst_repo / ch.rel
        if ch.action == "merge" and ch.rel == "pyproject.toml":
            _rel, merged, _ = plan_pyproject(src_repo, dst_repo)
            if dry_run:
                print(f"  ~ merge  {ch.rel}  ({ch.detail})")
            else:
                dst.write_text(merged, encoding="utf-8")
                print(f"  ~ merge  {ch.rel}  ({ch.detail})")
            applied += 1
            continue

        src = src_repo / ch.rel
        if dry_run:
            print(f"  {'+' if ch.action == 'add' else '~'} {ch.action:6} {ch.rel}")
            applied += 1
            continue

        dst.parent.mkdir(parents=True, exist_ok=True)
        data = sanitize_file_bytes_or_text(src, sanitize=sanitize)
        if dst.exists():
            try:
                if dst.read_bytes() == data:
                    continue
            except OSError:
                pass
        dst.write_bytes(data)
        if src.stat().st_mode & 0o111:
            dst.chmod(dst.stat().st_mode | 0o111)
        print(f"  {'+' if ch.action == 'add' else '~'} {ch.action:6} {ch.rel}")
        applied += 1
    return applied


def run_leak_check(dst_repo: Path) -> int:
    leak_check = dst_repo / "bin" / "wiki-leak-check"
    if not leak_check.exists():
        print("ERROR: wiki-leak-check missing in destination after sync (fail closed).")
        return 1
    print("\nVerifying destination working tree with leak check...")
    res = subprocess.run([sys.executable, str(leak_check)], cwd=dst_repo, check=False)
    if res.returncode != 0:
        print("LEAK CHECK FAILED after sync.")
        return res.returncode or 1
    return 0


def summarize(changes: list[Change]) -> tuple[int, int, int]:
    adds = sum(1 for c in changes if c.action == "add")
    updates = sum(1 for c in changes if c.action in {"update", "merge"})
    skips = sum(1 for c in changes if c.action == "skip")
    return adds, updates, skips


def cmd_status_or_push(args: argparse.Namespace, source_root: Path) -> int:
    target = args.target_repo_path
    if target is None:
        target = default_brian_path(source_root)
        if target is None:
            print(
                "ERROR: No Brian repo found. Pass a path or clone brian next to kos "
                f"({source_root.parent / 'brian'})."
            )
            return 1
    else:
        target = target.expanduser().resolve()

    if not looks_like_engine_repo(target):
        print(f"ERROR: '{target}' is not a valid wiki engine repository.")
        return 1

    direction_err = assert_safe_direction(source_root, target)
    if direction_err:
        print(f"ERROR: {direction_err}")
        return 2

    sanitize = not args.no_sanitize
    dry_run = args.dry_run or args.action == "status"

    if (args.no_sanitize or args.skip_leak_check) and not args.i_understand_unsafe:
        print(
            "ERROR: --no-sanitize / --skip-leak-check require "
            "--i-understand-unsafe (dangerous; not for public targets)."
        )
        return 2

    src_role = classify_repo_role(source_root)
    dst_role = classify_repo_role(target)
    print(f"{'Planning' if dry_run else 'Syncing'} engine: {source_root.name} -> {target}")
    print(
        f"  mode={'dry-run' if dry_run else 'apply'}  sanitize={sanitize}  "
        f"direction={src_role}->{dst_role}"
    )
    print(
        "  one-way: KOS → Brian engine only (no pull; wiki/raw/skills never copied)"
    )
    print(
        "  preserves: README.md, resources/, wiki/, raw/, init personalization, "
        "Brian-only engine files, pyproject identity"
    )

    changes = build_plan(source_root, target, sanitize=sanitize)
    adds, updates, skips = summarize(changes)

    actionable = [c for c in changes if c.action != "skip"]
    if args.verbose or dry_run:
        for c in changes:
            if c.action == "skip" and not args.verbose:
                continue
            mark = {"add": "+", "update": "~", "merge": "~", "skip": "."}[c.action]
            extra = f"  ({c.detail})" if c.detail else ""
            print(f"  {mark} {c.action:6} {c.rel}{extra}")

    print(f"\n  summary: {adds} add, {updates} update/merge, {skips} unchanged/skipped")

    if not actionable:
        print("Already up to date.")
        if not dry_run and not args.skip_leak_check:
            return run_leak_check(target)
        return 0

    if dry_run and args.action == "status":
        print("\nRun: bin/wiki-sync-engine push   # apply (KOS → Brian only)")
        return 0

    if dry_run:
        print("\nDry run only — no files written.")
        return 0

    try:
        applied = apply_plan(source_root, target, changes, sanitize=sanitize, dry_run=False)
    except OSError as exc:
        print(f"ERROR during sync (fail closed): {exc}")
        return 1

    print(f"\nEngine sync complete ({applied} file(s) written).")
    print("Brian-owned paths left untouched (README, resources, wiki, init, …).")

    if not args.skip_leak_check:
        return run_leak_check(target)
    print("WARNING: leak check skipped (--skip-leak-check).")
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="wiki-sync-engine",
        description=(
            "Push KOS engine improvements into the Brian open-source repo "
            "(one-way KOS → Brian). Never copies company knowledge; never pulls."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  bin/wiki-sync-engine push\n"
            "  bin/wiki-sync-engine push ~/Repos/brian\n"
            "  bin/wiki-sync-engine push --dry-run\n"
            "  bin/wiki-sync-engine status\n"
            "\n"
            "direction:\n"
            "  Engine code only, KOS → Brian. There is no pull.\n"
            "  wiki/, raw/, internal/skills/, registry, and README are never synced.\n"
            "\n"
            "env:\n"
            "  BRIAN_REPO / BRIAN_PATH   override default ../brian lookup\n"
        ),
    )
    parser.add_argument(
        "action",
        choices=("push", "status"),
        help="push = apply engine overlay to Brian; status = show pending changes",
    )
    parser.add_argument(
        "target_repo_path",
        nargs="?",
        type=Path,
        default=None,
        help="Brian repo path (default: ../brian or $BRIAN_REPO)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show planned writes without modifying the destination",
    )
    parser.add_argument(
        "--no-sanitize",
        action="store_true",
        help="Disable brand sanitization (dangerous; requires --i-understand-unsafe)",
    )
    parser.add_argument(
        "--skip-leak-check",
        action="store_true",
        help="Skip post-sync leak check (dangerous; requires --i-understand-unsafe)",
    )
    parser.add_argument(
        "--i-understand-unsafe",
        action="store_true",
        help="Acknowledge unsafe flags (--no-sanitize / --skip-leak-check)",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Also list unchanged/skipped files",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    raw = list(argv if argv is not None else sys.argv[1:])
    # Hard-reject legacy reverse flow before argparse choices surface a generic error.
    if raw and raw[0] == "pull":
        print(
            "ERROR: 'pull' is not supported. Engine sync is one-way KOS → Brian only.\n"
            "Company knowledge (wiki/, raw/, skills) must never flow between repos via this tool."
        )
        return 2

    args = parse_args(raw)
    # Script-containing repo is the source candidate; direction gates still refuse
    # Brian→KOS if this script was copied into Brian.
    source_root = Path(__file__).resolve().parent.parent
    if args.action in {"push", "status"}:
        return cmd_status_or_push(args, source_root)
    print(f"Unknown action {args.action}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
