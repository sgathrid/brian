#!/usr/bin/env python3
"""
wiki-leak-check: Leak prevention gate for the Brian open-source knowledge base.

Scans the on-disk working tree (tracked + untracked) and fails closed on:
  - proprietary paths (raw/**, unapproved wiki/**, internal registry, etc.)
  - company branding / domain references
  - common secret material
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

# Paths that must never appear in the open-source tree (except explicit allow).
FORBIDDEN_PATH_REGEXES = [
    # Private source dumps must never ship. Engine scaffolds under internal/
    # (registry.md, skills/, prompts/) are part of the OSS product surface and
    # are gated by content patterns instead of path bans.
    re.compile(r"^raw/(?!\.gitkeep$).+"),
    # Private evaluation corpora stay in KOS only.
    re.compile(r"^benchmarks/"),
    # Private company overview slug must never appear under wiki/.
    re.compile(r"^wiki/entities/(?:k" + "rv" + r")-labs\.md$"),
    re.compile(r"^wiki/projects/"),
    re.compile(r"^wiki/concepts/"),
    re.compile(r"^wiki/clients?/"),
]

# Binary / non-text extensions skipped for content scans.
SKIP_SUFFIXES = {
    ".lock",
    ".png",
    ".jpg",
    ".jpeg",
    ".gif",
    ".webp",
    ".ico",
    ".pdf",
    ".zip",
    ".gz",
    ".bz2",
    ".xz",
    ".7z",
    ".pyc",
    ".pyo",
    ".so",
    ".dylib",
    ".dll",
    ".o",
    ".a",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".mp3",
    ".mp4",
    ".mov",
    ".wav",
}

SKIP_DIR_NAMES = {
    ".git",
    ".hg",
    ".svn",
    ".venv",
    "venv",
    "node_modules",
    "__pycache__",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    "dist",
    "build",
    ".tox",
}

# OSS-safe wiki surface only. Everything else under wiki/ is denied.
ALLOWED_WIKI_FILES = {
    "wiki/CONVENTIONS.md",
    "wiki/SCALING.md",
    "wiki/index.md",
    "wiki/tags.md",
    "wiki/backlinks.md",
    "wiki/sources.json",  # must remain empty / non-proprietary in OSS
    "wiki/entities/brian-overview.md",
    "wiki/entities/my-org-overview.md",
}

# Company brand/domain tokens split so this file stays clean if scanned itself.
_C = "K" + "rv"
_c = "k" + "rv"
_ORG = _C + "-Labs"
_DOM = _c + r"\.ai"
_DOM_ALT = _c + r"labs\.com"

FORBIDDEN_PATTERNS: list[tuple[re.Pattern[str], str]] = [
    (re.compile(rf"\b{_ORG}\b", re.IGNORECASE), "Company organization reference"),
    (re.compile(rf"\b{_C}\s+Labs\b", re.IGNORECASE), "Company name reference"),
    (re.compile(rf"\b{_C}\b"), "Company name reference"),
    (re.compile(rf"\b{_c}\b"), "Company name reference"),
    (re.compile(_DOM, re.IGNORECASE), "Company domain reference"),
    (re.compile(_DOM_ALT, re.IGNORECASE), "Legacy company domain reference"),
    (re.compile(rf"{_c}[_-]wiki", re.IGNORECASE), "Company package/marker reference"),
    (re.compile(r"\bsk-[A-Za-z0-9_-]{16,}\b"), "Possible OpenAI-style API key"),
    (re.compile(r"\bak-[A-Za-z0-9_-]{16,}\b"), "Possible API key"),
    (re.compile(r"\bghp_[A-Za-z0-9]{20,}\b"), "Possible GitHub PAT"),
    (re.compile(r"\bgho_[A-Za-z0-9]{20,}\b"), "Possible GitHub OAuth token"),
    (re.compile(r"\bghu_[A-Za-z0-9]{20,}\b"), "Possible GitHub user token"),
    (re.compile(r"\bghs_[A-Za-z0-9]{20,}\b"), "Possible GitHub server token"),
    (re.compile(r"\bghr_[A-Za-z0-9]{20,}\b"), "Possible GitHub refresh token"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b"), "Possible GitHub fine-grained PAT"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"), "Possible Slack token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "Possible AWS access key"),
    (re.compile(r"\bASIA[0-9A-Z]{16}\b"), "Possible AWS temporary access key"),
    (re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"), "Private key material"),
]


def _git_inventory(repo_root: Path) -> list[str] | None:
    """Return tracked + untracked (+ non-ignored) paths, or None if git unavailable."""
    try:
        res = subprocess.run(
            ["git", "ls-files", "-co", "--exclude-standard"],
            cwd=repo_root,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return None
    if res.returncode != 0:
        return None
    return [line.strip().replace("\\", "/") for line in res.stdout.splitlines() if line.strip()]


def _rglob_inventory(repo_root: Path) -> list[str]:
    files: list[str] = []
    for p in repo_root.rglob("*"):
        if not p.is_file():
            continue
        rel = p.relative_to(repo_root)
        if any(part in SKIP_DIR_NAMES or part.startswith(".") for part in rel.parts[:-1]):
            continue
        if rel.parts and rel.parts[0] in SKIP_DIR_NAMES:
            continue
        files.append(rel.as_posix())
    return files


def collect_files(repo_root: Path) -> list[str]:
    """Union of git inventory and a filesystem walk so post-sync untracked files are covered."""
    found: set[str] = set()
    git_files = _git_inventory(repo_root)
    if git_files is not None:
        found.update(git_files)
    # Always merge a working-tree walk so freshly copied (untracked) files are scanned.
    found.update(_rglob_inventory(repo_root))
    return sorted(found)


def is_skipped_binary(path: str) -> bool:
    return Path(path).suffix.lower() in SKIP_SUFFIXES


def main() -> int:
    repo_root = Path(__file__).resolve().parent.parent
    errors: list[str] = []

    print("Running Brian Leak Check (working tree)...")

    try:
        files = collect_files(repo_root)
    except OSError as exc:
        print(f"FAILED to inventory repository files: {exc}")
        return 1

    if not files:
        print("FAILED: no files discovered to scan (fail closed).")
        return 1

    for file_path in files:
        for rx in FORBIDDEN_PATH_REGEXES:
            if rx.search(file_path):
                errors.append(f"Forbidden file path: {file_path}")

        if file_path == "wiki" or file_path.startswith("wiki/"):
            if file_path not in ALLOWED_WIKI_FILES and file_path != "wiki":
                # Default-deny: any wiki path outside the allowlist fails.
                # Allow empty placeholder directories by only flagging real files.
                p = repo_root / file_path
                if p.is_file():
                    errors.append(f"Unapproved knowledge path in open-source repo: {file_path}")

        path = repo_root / file_path
        if not path.is_file() or is_skipped_binary(file_path):
            continue

        # Never content-scan this checker or the sync tool for their own brand-token fragments.
        if path.name in {"wiki-leak-check", "wiki-sync-engine"}:
            continue

        try:
            content = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            # Try latin-1 as a last resort for mixed encodings; still fail closed on OS errors.
            try:
                content = path.read_text(encoding="latin-1")
            except OSError as exc:
                errors.append(f"Unreadable file (fail closed): {file_path} ({exc})")
                continue
        except OSError as exc:
            errors.append(f"Unreadable file (fail closed): {file_path} ({exc})")
            continue

        for pattern, reason in FORBIDDEN_PATTERNS:
            for m in pattern.finditer(content):
                line_no = content.count("\n", 0, m.start()) + 1
                errors.append(
                    f"Sensitive pattern [{reason}] in {file_path}:{line_no} -> {m.group(0)!r}"
                )

        # OSS sources.json must stay empty / trivial — no private provenance map.
        if file_path == "wiki/sources.json":
            stripped = content.strip()
            if stripped not in {"", "[]", "{}", "null"}:
                # allow pretty-printed empty array
                import json as _json
                try:
                    data = _json.loads(stripped)
                    if data not in ([], {}, None):
                        errors.append(
                            "wiki/sources.json must be empty in open-source repo "
                            f"(found non-empty provenance data)"
                        )
                except Exception:
                    errors.append(
                        "wiki/sources.json must be empty JSON array/object in open-source repo"
                    )

    if errors:
        # De-dupe while preserving order
        seen: set[str] = set()
        unique: list[str] = []
        for e in errors:
            if e not in seen:
                seen.add(e)
                unique.append(e)
        print("\n".join(f"  - {e}" for e in unique))
        print(f"\nLEAK CHECK FAILED: {len(unique)} issue(s) detected.")
        return 1

    print("LEAK CHECK PASSED: Clean open-source working tree verified.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
